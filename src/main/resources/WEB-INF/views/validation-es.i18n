acme.validation.header.message  	= Debe tener entre 1 y 75 caracteres
acme.validation.text.message   		= Debe tener entre 1 y 255 caracteres 
acme.validation.phone.message       = Debe cumplir "^\\+?\\d{6,15}$"

acme.validation.iata.message	= Debe cumplir "^[A-Z]{3}$"
acme.validation.iata.duplicated.message	= Código IATA ya usado

acme.validation.aircraft.registration.duplicated.message = Código de registro ya en uso

acme.validation.service.promo.pattern.message = Debe cumplir "^[A-Z]{4}-[0-9]{2}$"
acme.validation.service.promo.year.message = Los últimos dos dígitos deben corresponder con el año actual
acme.validation.service.promo.duplicated.message = Código de promoción ya en uso
acme.validation.service.discount.mandatory.message = Si se provee un código de promoción, se debe especificar una cantidad a descontar

acme.validation.review.reviewable.one.message = Las reseñas deben apuntar a uno y solo un objeto a reseñar
acme.validation.review.reviewable.match.message = El campo reviewableType debe coincidir con el tipo del objeto a reseñar

acme.validation.job.duplicated-ticker.message  = Referencia ya usada
acme.validation.job.ticker.message			   = La referencia sólo puede contener letras, dígitos, subrayados y guiones
acme.validation.job.deadline.message		   = La fecha límite no puede ser anterior a una semana
acme.validation.job.workload.message    	   = Carga de trabajo incorrecta

acme.validation.whine.redress.message	 	   = Proporcione alguna justificación